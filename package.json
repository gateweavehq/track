{
	"name": "gateweave-track",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm --filter @gateweave/track-web dev",
		"dev:setup": "pnpm --filter @gateweave/track-web dev:setup",
		"dev:seed": "pnpm --filter @gateweave/track-web dev:seed",
		"doctor": "node scripts/doctor.mjs",
		"build": "pnpm -r build",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"check": "biome check",
		"format": "biome check --write",
		"verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"typescript": "catalog:"
	}
}
