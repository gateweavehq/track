// Track deploys from the repository root, where the "Deploy to Cloudflare" button looks for this
// file; the app itself lives in apps/web, which runs Wrangler and Vite against it.
{
	"$schema": "apps/web/node_modules/wrangler/config-schema.json",
	"name": "gateweave-track",
	"main": "apps/web/src/server.ts",
	"compatibility_date": "2026-10-01",
	// `global_fetch_strictly_public`: a request Track makes, such as a webhook's, to a host on its
	// own zone goes in through Cloudflare like anyone's, past its security settings and to the Worker
	// that serves it, never straight to the origin behind them.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Settings made in the dashboard stay through a deploy. Wrangler otherwise removes a plain-text
	// variable it does not find here, so the next push would quietly turn off Turnstile or email.
	"keep_vars": true,
	// Wrangler will not build a branch's Preview without this block, which would fail every push to a
	// branch, Dependabot's included. A Preview gets none of this file's bindings and none of the
	// Worker's secrets, so it only says that it is not set up. docs/self-hosting.md has the rest.
	"previews": {},
	"observability": { "enabled": true },
	"upload_source_maps": true,
	// Once a day, deletes sessions and invitations past their time. Environments inherit this.
	"triggers": { "crons": ["23 3 * * *"] },
	// Workspace directory and auth. The database is provisioned on first deploy.
	"d1_databases": [
		{ "binding": "DB", "database_name": "gateweave-track", "migrations_dir": "apps/web/migrations" }
	],
	// One Durable Object per workspace holds its issues and serves realtime sync. Rate limits on
	// sign-in, password reset and email are counted in one per client address or recipient.
	"durable_objects": {
		"bindings": [
			{ "name": "WORKSPACE", "class_name": "WorkspaceDO" },
			{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }
		]
	},
	"exports": {
		"WorkspaceDO": { "type": "durable-object", "storage": "sqlite" },
		"RateLimiter": { "type": "durable-object", "storage": "sqlite" }
	},
	// Email through Cloudflare Email Service. Nothing is sent until EMAIL_FROM names a sender on a
	// domain onboarded to Email Sending; without it, Track runs with email off.
	"send_email": [{ "name": "EMAIL" }],
	// Files attached to descriptions and comments. The bucket is created on first deploy; without
	// this binding Track runs with attachments off.
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "gateweave-track-files" }],
	// Optional: GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, BETTER_AUTH_URL, EMAIL_FROM, PUSH_VAPID_KEY,
	// TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY, INTAKE_EMAIL_DOMAIN, SIGN_UP_REQUEST_URL, which
	// the sign-in page links to as "Ask for access" while the owner has closed sign-up (see
	// apps/web/src/server/env.d.ts).
	"secrets": { "required": ["BETTER_AUTH_SECRET"] },
	// The top level is production. Staging is a separate Worker with its own database and
	// workspaces; bindings are not inherited, so they are repeated here.
	"env": {
		"staging": {
			"name": "gateweave-track-staging",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "gateweave-track-staging",
					"migrations_dir": "apps/web/migrations"
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "WORKSPACE", "class_name": "WorkspaceDO" },
					{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }
				]
			},
			"send_email": [{ "name": "EMAIL" }],
			"r2_buckets": [{ "binding": "FILES", "bucket_name": "gateweave-track-files-staging" }],
			"secrets": { "required": ["BETTER_AUTH_SECRET"] }
		},
		// Gateweave's public demo. Every visitor gets a private sandbox workspace, deleted after a
		// day by the Cron Trigger. A separate Worker with its own database and Durable Objects; it
		// shares nothing with production. Self-hosters do not need it (see docs/self-hosting.md).
		"demo": {
			"name": "gateweave-track-demo",
			// Only Gateweave deploys this environment, so its address can live here. With a route,
			// workers.dev stays off and the demo has one address.
			"routes": [{ "pattern": "track-demo.gateweave.com", "custom_domain": true }],
			"vars": { "TRACK_DEMO": "1" },
			"triggers": { "crons": ["*/10 * * * *"] },
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "gateweave-track-demo",
					"migrations_dir": "apps/web/migrations"
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "WORKSPACE", "class_name": "WorkspaceDO" },
					{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }
				]
			},
			// No send_email or R2 binding: the demo sends no email and keeps no files.
			"secrets": { "required": ["BETTER_AUTH_SECRET"] }
		}
	}
}
