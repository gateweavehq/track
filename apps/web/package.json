{
	"name": "@gateweave/track-web",
	"version": "0.0.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 4710 --strictPort",
		"dev:setup": "node scripts/dev-setup.mjs",
		"dev:seed": "tsx scripts/seed.ts",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "vite build && wrangler deploy",
		"deploy:staging": "vite build --mode staging && wrangler deploy",
		"typegen": "wrangler types && tsr generate",
		"typecheck": "wrangler types && tsr generate && tsc && tsc -p scripts && tsc -p test && tsc -p service-worker",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
		"auth:schema": "pnpm dlx auth@1.7.14 generate --config src/server/auth/cli.ts --output src/server/db/auth-schema.ts --yes"
	},
	"dependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "4.0.0",
		"@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.2.1",
		"@atlaskit/pragmatic-drag-and-drop-hitbox": "3.0.0",
		"@better-auth/mcp": "1.7.14",
		"@better-auth/oauth-provider": "1.7.14",
		"@fontsource-variable/inter": "5.3.0",
		"@gateweave/track-protocol": "workspace:*",
		"@gateweave/track-sync-client": "workspace:*",
		"@gateweave/track-sync-server": "workspace:*",
		"@modelcontextprotocol/server": "2.4.0",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.4",
		"better-auth": "1.7.14",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"drizzle-orm": "catalog:",
		"fractional-indexing": "4.0.0",
		"lucide-react": "1.62.0",
		"radix-ui": "1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.65.0",
		"@modelcontextprotocol/client": "2.4.0",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/devtools-vite": "0.8.5",
		"@tanstack/react-devtools": "0.10.13",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/router-cli": "1.167.46",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"drizzle-kit": "catalog:",
		"jose": "6.2.13",
		"miniflare": "5.20261023.0-beta",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.15",
		"tw-animate-css": "1.4.0",
		"typescript": "catalog:",
		"vite": "8.3.5",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
