# Copied to .dev.vars by `pnpm dev:setup`, which also fills in a random secret.
# The "Deploy to Cloudflare" button asks for every key set here, so the optional ones stay
# commented out. Uncomment one to use it.

# Signs sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional: enables "Sign in with GitHub". Callback URL: http://localhost:4710/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: enables signing in through an OpenID Connect provider. Needs the first three; see
# docs/self-hosting.md. Callback URL: http://localhost:4710/api/auth/callback/oidc
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=

# Optional: the deployment's GitHub App, which admins install on their repositories instead of
# adding a webhook by hand. Needs all four; see docs/self-hosting.md. GitHub must reach the app's
# address, so a local http://localhost receives no deliveries.
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_WEBHOOK_SECRET=

# Optional: pins the app's URL, which also turns on the MCP endpoint for AI agents
# (http://localhost:4710/mcp). Leave it out to accept any host, for example from your phone.
# BETTER_AUTH_URL=

# Optional: turns on email (invitations, password reset), such as "Gateweave Track <track@example.com>".
# In local dev nothing is sent: each email is printed in the terminal and saved to a file.
# EMAIL_FROM=

# Optional: turns on teams' public request forms, behind Turnstile. Cloudflare's test keys, which
# always pass, work locally: 1x00000000000000000000AA and 1x0000000000000000000000000000000AA.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional: turns on teams' intake email addresses, at a domain whose Email Routing sends every
# address to this Worker (a catch-all rule), such as requests.example.com.
# INTAKE_EMAIL_DOMAIN=

# Optional: the most megabytes of attached files each workspace may keep. Unlimited when unset.
# ATTACHMENT_QUOTA_MB=
